# Copy to .env for local development. Do not commit .env.

# API bind address. Use 0.0.0.0 when testing from another machine.
TSI_API_ADDR=0.0.0.0:18080

# Comma-separated origins allowed to call the Go API from browsers.
# Use exact origins in shared environments.
TSI_CORS_ALLOWED_ORIGINS=http://<dashboard-host>:5175,http://localhost:5175

# PostgreSQL container settings.
TSI_POSTGRES_DB=<database-name>
TSI_POSTGRES_USER=<database-user>
TSI_POSTGRES_PASSWORD=<local-password>
TSI_POSTGRES_PORT=55432

# Host-side database URL for local scripts and make targets.
TSI_DATABASE_URL=postgresql://<database-user>:<local-password>@localhost:55432/<database-name>

# Docker-network database URL used by docker-compose api-gateway-go.
TSI_DOCKER_DATABASE_URL=postgresql://<database-user>:<local-password>@postgres:5432/<database-name>

# Dashboard API proxy target for Vite dev server.
TSI_DASHBOARD_API_BASE_URL=http://127.0.0.1:18080

# Browser-facing API URL for built frontend deployments when not using the Vite proxy.
VITE_TSI_API_BASE_URL=http://<api-host>:18080
